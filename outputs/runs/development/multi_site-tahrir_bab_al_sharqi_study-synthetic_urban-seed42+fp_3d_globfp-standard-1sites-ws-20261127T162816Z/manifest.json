        "ITU-M2292",
        "3GPP-TR38921"
      ],
      "approved_by": "supervisor, as reported by the project owner on 2026-11-26 (configs/approvals.yaml)",
      "justification": "46 dBm is the macro downlink power in the 3GPP 6G coverage assumptions (TR 38.914 Table 5.1.20.1-2), the E-UTRA reference base station (TR 36.942 Table 4.6), ITU-R M.2292 macro urban (Tables 3-4) and TR 38.921 (two polarisations, 7 GHz range). The same total power in every band; the power per MHz therefore falls with bandwidth (33 dBm/MHz at 20 MHz, 26 at 100 MHz, 20 at 400 MHz)."
    },
    "tx_antenna_gain_dbi": {
      "value": 0.0,
      "unit": "dBi added after tracing",
      "status": "approved",
      "sources": [
        "3GPP-TR38901"
      ],
      "approved_by": "supervisor, as reported by the project owner on 2026-11-26 (configs/approvals.yaml)",
      "justification": "Zero because the traced tr38901 pattern already contains the 8 dBi peak gain; any other value would count the gain twice (refused when the file is loaded)."
    },
    "tx_antenna_pattern": {
      "value": "tr38901",
      "unit": "pattern name",
      "status": "approved",
      "sources": [
        "3GPP-TR38901",
        "ITU-M2412"
      ],
      "approved_by": "supervisor, as reported by the project owner on 2026-11-26 (configs/approvals.yaml)",
      "justification": "3GPP TR 38.901 Table 7.3-1 sector element (65 degree beamwidth, 8 dBi peak, 30 dB front-to-back), the element ITU-R M.2412 also uses. It is TRACED by the ray tracer, so its gain is part of the path gain."
    },
    "sectors_per_site": {
      "value": 3,
      "unit": "sectors",
      "status": "approved",
      "sources": [
        "ITU-M2412",
        "ITU-M2292"
      ],
      "approved_by": "supervisor, as reported by the project owner on 2026-11-26 (configs/approvals.yaml)",
      "justification": "Three sectors per site (M.2412 section 8.3: three TRxPs per site)."
    },
    "mechanical_downtilt_deg": {
      "value": 10.0,
      "unit": "degrees below horizon",
      "status": "approved",
      "sources": [
        "ITU-M2292",
        "3GPP-TR38921"
      ],
      "approved_by": "supervisor, as reported by the project owner on 2026-11-26 (configs/approvals.yaml)",
      "justification": "Macro urban downtilt of 10 degrees (M.2292 Tables 3-4; TR 38.921 Table 8.1.2-1)."
    },
    "antenna_height_above_roof_m": {
      "value": 3.0,
      "unit": "m",
      "status": "approved",
      "sources": [
        "APPROVAL-2026-11-26"
      ],
      "approved_by": "supervisor, as reported by the project owner on 2026-11-26 (configs/approvals.yaml)",
      "justification": "Decision A4. No primary source gives a mast height above a roof; the references give total heights (25 m in M.2412 and TR 38.901 UMa) for flat layouts. Antennas stand at the roof edge facing each sector (configs/site_rule.yaml)."
    },
    "rx_height_m": {
      "value": 1.5,
      "unit": "m above ground",
      "status": "approved",
      "sources": [
        "ITU-M2412"
      ],
      "approved_by": "project description, Stage 6 (the approved project baseline)",
      "justification": "Receivers 1.5 m above street level; the outdoor UE height of M.2412 Table 5(b)."
    },
    "rx_antenna_gain_dbi": {
      "value": 0.0,
      "unit": "dBi",
      "status": "approved",
      "sources": [
        "3GPP-TR36942",
        "ITU-M2412",
        "3GPP-TR38830"
      ],
      "approved_by": "supervisor, as reported by the project owner on 2026-11-26 (configs/approvals.yaml)",
      "justification": "Isotropic user antenna, matching the isotropic receiver of the ray-traced maps (0 dBi in TR 36.942 section 4.2.2, M.2412 at 4 GHz, TR 38.830 for FR1). M.2412 and TR 38.830 give 5 dBi at 30 GHz with user-side beamforming, left to the deployment interpretation."
    },
    "noise_figure_db": {
      "value": 9.0,
      "unit": "dB",
      "status": "approved",
      "sources": [
        "3GPP-TR38914",
        "3GPP-TR36942",
        "ITU-M2292",
        "3GPP-TR38921"
      ],
      "approved_by": "supervisor, as reported by the project owner on 2026-11-26 (configs/approvals.yaml)",
      "justification": "9 dB user noise figure in the 3GPP 6G coverage assumptions (TR 38.914 Table 5.1.20.1-2), TR 36.942 Table 4.8, M.2292 Table 1 and the TR 38.921 baseline. Per-band values (7 dB at 4 GHz, 10 dB at 30 GHz in M.2412) belong to the deployment interpretation."
    },
    "noise_temperature_k": {
