# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Agent tool state (not part of the project)
.claude-flow/
.swarm/

# Large original downloads are cached here, never committed; data/raw keeps
# small extracts plus manifests with checksums and download instructions.
data/raw/**/*.zip

# Generated data: rebuilt from data/raw by scripts
data/processed/
data/scenes/
data/cache/

# Run outputs: large arrays stay local, JSON summaries are kept
outputs/**/*.npz
outputs/**/*.png

# Application run state (logs of runs started from the app) and large CSV exports
outputs/app_runs/
outputs/**/cells_*.csv
outputs/**/near_site_*.json
